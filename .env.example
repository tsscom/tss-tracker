# Copie para .env. Não publique nem partilhe o ficheiro .env.
# json: mantém o piloto atual em data/jobs.json.
# postgres: usa exclusivamente PostgreSQL; não regressa a JSON em caso de falha.
STORAGE_BACKEND=json

# Preencha depois de criar uma base de dados local e um utilizador dedicado.
# Codifique caracteres especiais da palavra-passe em formato URL (%40 para @, por exemplo).
# Substitua a palavra-passe ilustrativa; esta conta não é criada automaticamente.
DATABASE_URL=postgresql://tss_app:SUBSTITUIR_POR_PALAVRA_PASSE@127.0.0.1:5432/tss_gestao

# Por predefinição, acesso apenas neste computador.
PORT=4317
HOST=127.0.0.1

# Teste opcional de Android/iPhone na mesma rede privada: requer HTTPS confiável.
# Substitua o IP pelo real; consulte README e documentacao/05_Mobile_e_operacoes.md.
# HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.50:4317
# TLS_KEY_FILE=data/tls/server-key.pem
# TLS_CERT_FILE=data/tls/server-cert.pem
